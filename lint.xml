<?xml version="1.0" encoding="utf-8"?>
<!-- Einstellungen für die Code-Prüfung (Lint) im Build -->
<lint>
    <!-- Übersetzungen kommen nach und nach über Weblate, fehlende Texte erscheinen auf Englisch -->
    <issue id="MissingTranslation" severity="ignore" />
    <issue id="MissingQuantity" severity="ignore" />
    <issue id="ExtraTranslation" severity="warning" />
    <!-- Der Dienst wird im Manifest absichtlich entfernt, die Klasse fehlt deshalb zu Recht -->
    <issue id="MissingClass">
        <ignore regexp="SystemForegroundService" />
    </issue>
    <!-- Die App-Sperre prüft die Android-Version schon in prompt(), bevor sie den Systemdialog aufruft -->
    <issue id="NewApi">
        <ignore regexp="AppLock\.kt" />
    </issue>
    <!-- Mehrzahl-Formen in Übersetzungen pflegen die Übersetzer:innen auf Weblate -->
    <issue id="ImpliedQuantity" severity="warning" />
    <!-- Kein Absturz: Texte könnten nach einem Sprachwechsel kurz veraltet sein. Bleibt als Hinweis sichtbar -->
    <issue id="LocalContextGetResourceValueCall" severity="warning" />
    <issue id="NonObservableLocale" severity="warning" />
</lint>
