<?xml version="1.0" encoding="utf-8"?>
<!-- Hintergrund der großen Widget-Karte: Weinrot-Verlauf mit weichem Lichtschein oben rechts -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="28dp" />
            <gradient
                android:angle="315"
                android:startColor="#FF8C2A45"
                android:centerColor="#FF5E1428"
                android:endColor="#FF2E0812" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="28dp" />
            <gradient
                android:type="radial"
                android:centerX="0.95"
                android:centerY="0.05"
                android:gradientRadius="220dp"
                android:startColor="#40FFB2B9"
                android:endColor="#00FFB2B9" />
        </shape>
    </item>
</layer-list>
